{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.2/.schema/devbox.schema.json",
  "packages": [
    "terraform@latest",
    "opentofu@latest",
    "kubectl@latest",
    "kubectx@latest",
    "kubecolor@latest",
    "k9s@latest",
    "kubernetes-helm@latest",
    "helmfile@latest",
    "kubelogin-oidc@latest",
    "fluxcd@latest",
    "sops@latest",
    "trivy@latest",
    "hcloud@latest",
    "awscli2@latest",
    "azure-cli@latest",
    "yq-go@latest",
    "jq@latest",
    "fzf@latest",
    "ripgrep@latest",
    "fd@latest",
    "yamlfmt@latest",
    "lazygit@latest",
    "git-filter-repo@latest",
    "grpcurl@latest",
    "swaks@latest",
    "nmap@latest",
    "tree@latest",
    "watch@latest",
    "stern@latest",
    "neovim@latest"
  ],
  "env": {
    "DEVBOX_ENV": "sre"
  },
  "shell": {
    "init_hook": [
      "echo '╭─ devbox: SRE toolkit ready'",
      "echo '╰─ use `devbox info <pkg>` for versions, `devbox run <script>` for shortcuts'"
    ],
    "scripts": {
      "tf-plan": [
        "terraform init -upgrade",
        "terraform plan -out=tfplan"
      ],
      "tf-apply": [
        "terraform apply tfplan"
      ],
      "tf-fmt": [
        "terraform fmt -recursive ."
      ],
      "k-watch": [
        "watch -n 2 'kubectl get pods,svc,ingress -A'"
      ],
      "yaml-lint": [
        "yamlfmt -lint -formatter basic,indentless_arrays=true ."
      ],
      "trivy-scan": [
        "trivy fs --severity HIGH,CRITICAL ."
      ]
    }
  }
}
